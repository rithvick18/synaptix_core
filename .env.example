# Checkpoint F — agent-assisted caregiver setup (SPEC.md §10). Local dev only.
# Copy to .env (git-ignored) and fill in to enable a real provider adapter.
# With agent.enabled: false (the shipped default) none of this is read.

# --- Hosted provider (provider: 'anthropic') -------------------------------
VITE_AGENT_API_KEY=
VITE_AGENT_MODEL=claude-opus-5

# --- Local provider (provider: 'llamacpp') ---------------------------------
# No API key and no account: a model running on this machine under llama.cpp.
# Must be a VISION model — the pipeline hands it a JPEG (SPEC.md §10.4/§10.5) and a
# text-only GGUF cannot do this job at any size.
#
#   llama-server -hf ggml-org/Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M --host 127.0.0.1 --port 8080
#
# Leave the endpoint empty to use the loopback default (http://127.0.0.1:8080).
# Pointing it at a non-loopback address changes what the consent dialog tells the
# caregiver, because it changes whether their photos leave the machine.
VITE_AGENT_LLAMACPP_ENDPOINT=
VITE_AGENT_LLAMACPP_MODEL=qwen2.5-vl-3b-instruct-q4_k_m
# Only if you started llama-server with --api-key.
VITE_AGENT_LLAMACPP_API_KEY=
