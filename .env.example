# Checkpoint F — agent-assisted caregiver setup (SPEC.md §10). Local dev only.
# Copy to .env (git-ignored). Read when Generate environment from photos is clicked.
#
# Nothing here is required. The app asks at start whether to run the model OFFLINE or
# ONLINE, and the online key can be typed straight into that setup screen. These values
# only spare a developer from re-typing them.

# ---------------------------------------------------------------------------
# Offline setup — llama.cpp on this machine. Nothing reaches the internet.
# ---------------------------------------------------------------------------
#
# There is no API key here and no account to create — you run the model yourself:
#
#   llama-server -m models/gemma-3-4b/gemma-3-4b-it-Q4_K_M.gguf \
#                --mmproj models/gemma-3-4b/mmproj-model-f16.gguf \
#                --host 127.0.0.1 --port 8080 --ctx-size 8192 --parallel 1 \
#                --alias local --cors-origins http://localhost:5173
#
# --mmproj is the vision projector; without it the model cannot see the photographs and
# every image-derived proposal will be wrong or absent. --cors-origins matters: this app
# runs in a browser tab on a different origin (the Vite dev server) and calls llama-server
# directly, so a missing or mismatched value here is the "CORS request did not succeed"
# error in the browser console. Match it to whatever origin actually serves the app — the
# Vite dev server's port if it is not 5173, or the deployed origin for a built app. This
# must be the exact command used in README.md; if you change one, change the other.

# Must be loopback. The adapter refuses anything else — see src/agent/llamaCpp.ts.
VITE_AGENT_BASE_URL=http://127.0.0.1:8080

# Informational only; llama-server serves whichever .gguf it was started with.
VITE_AGENT_MODEL=gemma-3-4b-it-Q4_K_M

# ---------------------------------------------------------------------------
# Online setup — Google's Gemini API. Probe images cross the internet.
# ---------------------------------------------------------------------------
#
# Create a key at https://aistudio.google.com/apikey. It is sent as the x-goog-api-key
# header to generativelanguage.googleapis.com and nowhere else: src/agent/gemini.ts
# refuses any other host before it opens a socket.
#
# A key put here is baked into the built bundle by Vite, like every VITE_ variable. For
# anything but your own machine, leave it blank and type the key into the setup screen
# instead — that one is kept in the browser rather than in the build.
VITE_GEMINI_API_KEY=

# Defaults to gemini-3.5-flash-lite when unset.
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
